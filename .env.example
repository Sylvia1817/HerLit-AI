# Use mock for deterministic local development, live for configured adapters.
EDITORIAL_PROVIDER_MODE=mock

# OpenAI Responses API. Never commit real secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_RESPONSES_BASE_URL=https://api.openai.com/v1/responses
OPENAI_MAX_OUTPUT_TOKENS=6000

# Tavily Search API. Basic search is used to bound per-run cost.
TAVILY_API_KEY=
TAVILY_SEARCH_BASE_URL=https://api.tavily.com/search

# Opt-in smoke test only. The test refuses a declared cap above USD 1.
EDITORIAL_LIVE_SMOKE=0
EDITORIAL_LIVE_SMOKE_MAX_USD=1
EDITORIAL_LIVE_SMOKE_DATE=2026-08-18
