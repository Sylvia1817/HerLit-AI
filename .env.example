# Use mock for deterministic local development, live for configured adapters.
EDITORIAL_PROVIDER_MODE=mock

# Generic JSON model adapter. Never commit real secrets.
EDITORIAL_MODEL_PROVIDER=
EDITORIAL_MODEL_BASE_URL=
EDITORIAL_MODEL_API_KEY=
EDITORIAL_MODEL_NAME=

# Generic normalized search adapter. It must return real traceable URLs.
EDITORIAL_SEARCH_PROVIDER=
EDITORIAL_SEARCH_BASE_URL=
EDITORIAL_SEARCH_API_KEY=
