# Use mock for deterministic local development, live for configured adapters.
EDITORIAL_PROVIDER_MODE=mock

# ---------------------------------------------------------------------------
# Model service (required in live mode)
# ---------------------------------------------------------------------------
# Protocol must match the service. Do not point a vendor endpoint at
# generic_json: it expects a HerLit JSON-task server, not an LLM API.
#   generic_json       = HerLit JSON task protocol (custom proxy)
#   openai_chat        = any OpenAI-compatible /chat/completions service
#   anthropic_messages = Anthropic Messages API
EDITORIAL_MODEL_PROTOCOL=generic_json
EDITORIAL_MODEL_PROVIDER=
# Full endpoint or base URL. Base URLs ending in /v1 get the canonical path.
EDITORIAL_MODEL_BASE_URL=
EDITORIAL_MODEL_API_KEY=
EDITORIAL_MODEL_NAME=

# Optional tuning.
# EDITORIAL_MODEL_TIMEOUT_MS=120000
# EDITORIAL_MODEL_ATTEMPTS=2
# EDITORIAL_MODEL_JSON_MODE=auto
# EDITORIAL_MODEL_MAX_OUTPUT_TOKENS=

# ---------------------------------------------------------------------------
# Search service (required in live mode)
# ---------------------------------------------------------------------------
#   generic_json = HerLit normalized search protocol
#   brave        = Brave Search API
#   tavily       = Tavily Search API
#   serper       = Serper (Google) API
EDITORIAL_SEARCH_PROTOCOL=generic_json
EDITORIAL_SEARCH_PROVIDER=
# Optional for brave/tavily/serper (public endpoints are built in).
EDITORIAL_SEARCH_BASE_URL=
EDITORIAL_SEARCH_API_KEY=

# Optional tuning.
# EDITORIAL_SEARCH_TIMEOUT_MS=20000
