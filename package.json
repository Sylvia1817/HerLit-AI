{
  "name": "herlit-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node node_modules/vinext/dist/cli.js dev",
    "build": "node node_modules/vinext/dist/cli.js build",
    "start": "node node_modules/vinext/dist/cli.js start",
    "test": "npm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/*.test.ts",
    "lint": "node node_modules/eslint/bin/eslint.js . --ignore-pattern dist --ignore-pattern .next",
    "typecheck:editorial": "node node_modules/typescript/bin/tsc -p tsconfig.editorial.json",
    "db:generate": "drizzle-kit generate",
    "test:browser": "node --test tests/browser-flow.test.mjs",
    "smoke:live": "node --experimental-strip-types --env-file-if-exists=.env scripts/live-smoke.ts",
    "render:cards": "node --experimental-strip-types --env-file-if-exists=.env scripts/render-cards.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "1.56.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
