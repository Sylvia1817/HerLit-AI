{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": false,
    "strict": true
  },
  "include": [
    "types/editorial.ts",
    "lib/editorial-selection/**/*.ts",
    "lib/research-verification/**/*.ts",
    "lib/editorial-production/**/*.ts",
    "lib/editorial-workbench/**/*.ts",
    "app/api/editorial/**/*.ts",
    "app/page.tsx",
    "tests/*.test.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "runtime",
    "dist",
    ".next"
  ]
}
